# CalSEVA v2 Environment Configuration Template
# Copy this file to '.env' and fill in your local or production values

# Flask Secret Key for Session Encryption
SECRET_KEY=calseva_super_secret_session_encryption_key

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/calsevav2

# Gmail SMTP Configuration for OTP Delivery
GMAIL_SENDER=supportcalsevatec@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Third-Party Email APIs (Optional Render/Production compliance)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SENDGRID_API_KEY=

# Firebase Authentication Credentials
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Firebase Cloud Messaging (FCM) & Web Push VAPID Configuration
FIREBASE_MESSAGING_SENDER_ID=104417696551
FIREBASE_VAPID_KEY=BG9hLohg7jKRV_NC6NxVLCYr2J136Qldq8PQFMJ1ogwBuQBEs70EwJzINX3hrInBXtK_K_jcLEAj05mwKCLzRC4

# Firebase Admin SDK Credentials (JSON Base64 string OR path to serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Admin User Identification (Comma-separated list of Employee IDs allowed to send push notifications)
ADMIN_EMPLOYEE_IDS=12345
